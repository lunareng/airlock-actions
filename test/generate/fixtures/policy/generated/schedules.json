{
  "_comment": "GENERATED by acme/policy with lunareng/airlock-actions/generate. Read by acme's clock; cron fields are UTC, 5-field (minute hour day-of-month month day-of-week; *, n, a-b, a,b and */n).",
  "repo": "acme/policy",
  "ref": "main",
  "schedules": [
    {
      "workflow": "role-builder.yml",
      "cron": "0 */6 * * *",
      "inputs": {
        "clock": "true"
      }
    },
    {
      "workflow": "role-reviewer.yml",
      "cron": "30 8 * * 1",
      "inputs": {
        "clock": "true"
      }
    },
    {
      "workflow": "role-router.yml",
      "cron": "*/30 * * * *",
      "inputs": {
        "clock": "true",
        "dry_run": "false"
      }
    },
    {
      "workflow": "role-triage.yml",
      "cron": "15 9 * * 1-5",
      "inputs": {
        "clock": "true"
      }
    },
    {
      "workflow": "role-triage.yml",
      "cron": "0 14 * * 3",
      "inputs": {
        "clock": "true",
        "signal": "routine:weekly"
      }
    }
  ]
}
