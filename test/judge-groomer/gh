#!/usr/bin/env python3
"""A fake `gh` for the groomer judge's tests: `gh api <path>?<query>` answered from GH_ANSWERS (fixtures/github.json's
shape), every call logged to GH_LOG. The first rule that fits answers; page 2 onwards of a list is empty unless a rule
names its page; anything else is GitHub's 404. It reads the endpoint as `gh api` does, as a URL: a raw `#` starts a
fragment, so it is refused here rather than silently cutting the query short, and a timestamp whose `+` decoded to a
space is GitHub's 422."""
import json, os, sys, urllib.parse
with open(os.environ["GH_LOG"], "a") as log:
    log.write(json.dumps(sys.argv[1:]) + "\n")
if sys.argv[1:2] != ["api"] or len(sys.argv) != 3:
    sys.stderr.write("fake gh: only `gh api <path>`\n"); sys.exit(2)
if "#" in sys.argv[2]:
    sys.stderr.write("fake gh: a raw # in the endpoint is a URL fragment: GitHub would never see the rest\n"); sys.exit(2)
path, _, query = sys.argv[2].partition("?")
params = {k: v[0] for k, v in urllib.parse.parse_qs(query).items()}
if " " in params.get("since", ""):
    sys.stderr.write("gh: Validation Failed (HTTP 422): since is not a timestamp\n"); sys.exit(1)
for rule in json.load(open(os.environ["GH_ANSWERS"]))["rules"]:
    if rule["path"] != path or any(params.get(k) != v for k, v in rule.get("params", {}).items()):
        continue
    if not all(s in params.get("q", "") for s in rule.get("q_contains", [])):
        continue
    if "raw" in rule:  # an answer as written, JSON or not
        print(rule["raw"]); sys.exit(0)
    answer = rule["answer"]
    if isinstance(answer, list) and "page" not in rule.get("params", {}) and params.get("page", "1") != "1":
        answer = []
    print(json.dumps(answer)); sys.exit(0)
sys.stderr.write("gh: Not Found (HTTP 404)\n"); sys.exit(1)
